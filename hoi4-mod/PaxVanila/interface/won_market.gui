# Wealth of Nations - International Market window (merged from Arsenal of Nations)
guiTypes = {

	#------------------------- ARMS TRADE BUTTON (overview tab, under "Auto request access") ----------------------------

	containerWindowType = {
		name = "aon_bureau_button_window"
		position = { x = 350 y = 280 }

		buttonType = {
			name = "aon_bureau_button"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_government_button"
			buttonFont = "hoi_16mbs"
			Orientation = "UPPER_RIGHT"
			pdx_tooltip = "AON_BUREAU_BUTTON_TT"
			clicksound = click_default
		}

		instantTextboxType = {
			name = "aon_bureau_button_text"
			position = { x = 38 y = 9 }
			font = "hoi_16mbs"
			text = "AON_BUREAU_BUTTON"
			Orientation = "UPPER_LEFT"
			maxWidth = 130
			alwaystransparent = yes
			format = left
		}

		iconType = {
			name = "aon_bureau_button_icon"
			spriteType = "GFX_decision_category_generic_arms_trade"
			position = { x = 2 y = 3 }
			scale = 0.7
			alwaystransparent = yes
		}
	}

	#------------------------- ARMS TRADE BUREAU PANEL ----------------------------

