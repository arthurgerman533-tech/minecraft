guiTypes = {
	# Wealth of Nations top-bar readout (generated). Click opens the Ministry of Economy.
	containerWindowType = {
		name = "won_topbar_window"
		position = { x = 1030 y = 5 }
		orientation = UPPER_LEFT
		size = { width = 92 height = 30 }
		moveable = no
		clipping = no
		background = {
			name = "won_topbar_bg"
			quadTextureSprite = "GFX_mini_tooltip"
		}
		iconType = {
			name = "won_topbar_icon"
			spriteType = "GFX_economy_tab"
			position = { x = 4 y = 3 }
			scale = 0.6
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "won_topbar_text"
			position = { x = 30 y = 5 }
			font = "hoi_18mbs"
			text = "won_topbar_text"
			maxWidth = 58
			maxHeight = 24
			fixedsize = yes
			format = left
			alwaystransparent = yes
		}
		buttonType = {
			name = "won_topbar_button"
			position = { x = 0 y = 0 }
			spriteType = "GFX_won_hitbox"
			pdx_tooltip = "won_topbar_tt"
			clicksound = click_default
			oversound = ui_menu_over
		}
	}
}
